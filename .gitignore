# 忽略以下文件和目录
node_modules/
dist/
dev/
DS_Store
# 忽略 UniApp 编译生成的小程序相关目录
unpackage/
# 忽略本地配置文件（请根据实际情况修改）
manifest.local.json
# 忽略编辑器自动生成的文件
idea/
vscode/
# 忽略日志文件
logs/
# 忽略临时文件
temp/
# 忽略构建工具自动生成的文件
build/
# 忽略 npm 安装的包文件
package-lock.json
yarn.lock
# 忽略环境变量文件（含 API Key，禁止提交到代码库）
.env
.env.local
.env.*.local